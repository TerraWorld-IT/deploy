# TerraWorld Mac 배포 호스트 값 템플릿.
#
# 사용:
#   test -e mac-host.env || cp mac-host.env.example mac-host.env
#   chmod 600 mac-host.env
#   vi mac-host.env
#   bash scripts/bootstrap-mac-host.sh
#
# 실제 값을 채운 mac-host.env 는 권한 600이고 .gitignore 대상이어야 한다. 저장소 안의 다른
# --config 경로도 gitignore 대상만 허용하며, 이 example은 check 전용이다. 실제 사용자명,
# 도메인, 토큰, 키, 비밀번호를 example에 넣지 않는다.

# ── 호스트와 GitHub Actions runner ───────────────────────────────────────────

# [필수] deploy 저장소가 실제로 있는 절대 경로. 공백, 따옴표, $, 백틱은 허용하지 않는다.
# 얻는 곳: Mac 에서 deploy 저장소 디렉터리로 이동한 뒤 `pwd -P` 출력.
TERRAWORLD_DEPLOY_DIR=__FILL_ABSOLUTE_DEPLOY_PATH__

# [필수] GitHub Actions runner 압축을 푼 절대 경로. 위 경로와 같은 문자 계약을 적용한다.
# 얻는 곳: runner 디렉터리로 이동한 뒤 `pwd -P` 출력.
TERRAWORLD_RUNNER_DIR=__FILL_ABSOLUTE_RUNNER_PATH__

# [필수] runner 를 등록할 GitHub 범위 URL. https://github.com/ 뒤에는 영문, 숫자, ._/-만 허용.
# 얻는 곳: GitHub 조직 또는 저장소의 Settings > Actions > Runners > New runner 화면.
# backend 와 frontend 모두 같은 runner 를 쓰려면 두 저장소 접근이 허용된 조직 runner 권장.
TERRAWORLD_RUNNER_SCOPE_URL=__FILL_GITHUB_ORG_OR_REPOSITORY_URL__

# [필수] GitHub Runners 화면에서 식별할 이름. 영문, 숫자, 점, 밑줄, 하이픈만 허용한다.
# 얻는 곳: Mac 의 공유 가능한 호스트 이름을 정하거나 운영자가 직접 정한다.
TERRAWORLD_RUNNER_NAME=__FILL_RUNNER_NAME__

# 등록 라벨은 값으로 바꾸지 않는다: 워크플로 계약은 정확히 `terraworld` 이다.
# 등록 토큰은 1시간 내 만료되는 시크릿이므로 이 파일에 저장하지 않는다. 등록 시 프롬프트에만 입력한다.

# ── deploy/.env 로 생성할 값 ────────────────────────────────────────────────
# 아래 두 경계 사이를 먼저 별도 payload로 추출한 뒤 그 payload만 검증·복사한다. 신규 생성 값은
# Compose에서 원문이 달라지지 않는 문자(A-Z a-z 0-9 . _ / : ? @ % + , = & ~ -)만 허용한다.
# 공백, 따옴표, $, 백슬래시, #, 백틱이 필요하면 bootstrap 생성 경로를 쓰지 말고 운영자가 권한
# 600의 deploy/.env를 직접 준비한다. 기존 deploy/.env는 절대 덮어쓰거나 병합하지 않는다.
#
# DB_PASSWORD와 토큰/서명 시크릿은 `openssl rand -hex 32`처럼 허용 문자 안의 값을 사용한다.
# 같은 도메인·DB명·DB사용자·DB비밀번호가 들어가는 파생 URL도 함께 일치시켜야 한다.

# === TERRAWORLD_COMPOSE_ENV_BEGIN ===

# [필수] 서비스 공개 도메인. 얻는 곳: DNS/인프라 담당자가 이 호스트에 배정한 도메인.
DEPLOY_DOMAIN=__FILL_DEPLOY_DOMAIN__

# [필수] PostgreSQL DB 이름/사용자. 얻는 곳: 운영 DB 설계값; 신규 호스트면 운영자가 정한다.
DB_NAME=terraworld
DB_USER=terraworld

# [필수/시크릿] PostgreSQL 비밀번호. 허용 문자 계약 안의 신규 난수 또는 기존 보안 저장소에서 획득.
DB_PASSWORD=__FILL_STRONG_DB_PASSWORD__

# [필수/파생] 위 DB_NAME 과 같은 값으로 맞춘 Spring JDBC URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/terraworld?currentSchema=public

# [필수/파생] 위 DB_USER, DB_PASSWORD, DB_NAME 과 같은 값으로 맞춘 better-auth URL.
# DB_PASSWORD 에 예약문자가 있으면 URL 인코딩한 값을 이 URL에 사용한다.
DATABASE_URL=postgresql://terraworld:__FILL_URL_ENCODED_DB_PASSWORD__@postgres:5432/terraworld?options=-c%20search_path%3Dauth%2Cpublic

# [필수/시크릿] better-auth 서명 시크릿. 허용 문자 계약 안의 값(예: `openssl rand -hex 32`) 사용.
BETTER_AUTH_SECRET=__FILL_BETTER_AUTH_SECRET__

# [필수/파생] DEPLOY_DOMAIN 과 같은 도메인.
BETTER_AUTH_URL=https://__FILL_DEPLOY_DOMAIN__

# [고정/필수] 컨테이너 내부 frontend JWKS 주소와 JWT 계약. 저장소 애플리케이션 설정에서 정해진 값.
AUTH_JWKS_URL=http://frontend:3000/api/auth/jwks
AUTH_JWT_ISSUER=terraworld
AUTH_JWT_AUDIENCE=terraworld-api

# [필수/시크릿] frontend-to-backend 내부 토큰. 허용 문자 계약 안의 값 사용.
INTERNAL_API_TOKEN=__FILL_INTERNAL_API_TOKEN__

# [고정/필수] 컨테이너 내부 backend 주소.
INTERNAL_API_BASE_URL=http://backend:8080

# [필수/파생] 허용 공개 origin. DEPLOY_DOMAIN 과 같은 도메인이고 localhost 를 넣지 않는다.
CORS_ALLOWED_ORIGINS=https://__FILL_DEPLOY_DOMAIN__

# [고정/필수] compose 내부 Redis 서비스 이름과 포트.
REDIS_HOST=redis
REDIS_PORT=6379

# [고정/필수] Spring 운영 프로파일.
SPRING_PROFILES_ACTIVE=prod

# [필수/파생] 브라우저/WebView 공개 URL. DEPLOY_DOMAIN 과 같은 도메인.
NUXT_PUBLIC_API_BASE_URL=https://__FILL_DEPLOY_DOMAIN__/api/v1
NUXT_PUBLIC_AUTH_BASE_URL=https://__FILL_DEPLOY_DOMAIN__

# [선택/public] Meta 앱 ID. 얻는 곳: Meta for Developers 앱 대시보드.
# 값을 실제로 쓸 때만 주석을 제거한다.
# NUXT_PUBLIC_META_APP_ID=

# [선택/public] GA4 측정 ID. 얻는 곳: Google Analytics 데이터 스트림.
# 두 키에 같은 값을 넣고 실제로 쓸 때만 주석을 제거한다.
# NUXT_PUBLIC_GA_ID=
# NUXT_PUBLIC_GTAG_ID=

# [선택/public] AdSense/AdMob ID. 얻는 곳: 각 서비스 콘솔. 실제로 쓸 때만 주석을 제거한다.
# NUXT_PUBLIC_ADSENSE_CLIENT=
# NUXT_PUBLIC_ADSENSE_SLOT=
# NUXT_PUBLIC_ADMOB_REWARDED_AD_ID=

# [고정/필수] backend/frontend CI가 실제 push하는 공통 이미지 prefix. 변경하지 않는다.
REGISTRY_URL=ghcr.io/terraworld-it

# [필수/현재 동작 보존] 두 서비스가 공통으로 pull 하는 태그. M1 에서는 latest 를 유지한다.
TAG=latest

# [선택/public] App/Universal Links 값. 얻는 곳: Apple Developer 팀 정보와 Android 릴리스 keystore.
IOS_TEAM_ID=
ANDROID_SHA256_FINGERPRINT=

# [선택/시크릿 포함] R2 사진 저장. 얻는 곳: Cloudflare R2 버킷/API 토큰 설정.
# 미설정이면 기존 fallback 동작을 사용한다.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# [선택/시크릿] FCM 서비스 계정 JSON은 따옴표가 필요해 신규 생성 허용 문자 계약 밖이다.
# 필요하면 권한 600의 기존 deploy/.env를 운영자가 직접 준비하고 bootstrap에는 점검만 맡긴다.
# FCM_SERVICE_ACCOUNT_JSON=

# === TERRAWORLD_COMPOSE_ENV_END ===

# ── tunnel override 값 자리 ─────────────────────────────────────────────────
# [필수/미확인] docker-compose.tunnel.yml 이 요구하는 env 키는 파일 미회수로 아직 알 수 없다.
# 키를 추측해 만들면 운영 토폴로지를 덮을 수 있으므로 이 템플릿에는 임의의 TUNNEL_* 키를
# 두지 않았다. 현재 호스트의 실제 docker-compose.tunnel.yml 을 먼저 회수·검토한 뒤,
# 그 파일이 요구하는 정확한 키만 위 compose env 경계 안에 추가한다.
